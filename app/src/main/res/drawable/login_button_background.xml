<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/button_pressed_start"
                android:endColor="@color/button_pressed_end"
                android:angle="45" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_disabled" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/primary_green"
                android:endColor="@color/primary_blue"
                android:angle="45" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>