<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".CentreVoteFragment">

    <include layout="@layout/fragment_header"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">

                <!-- Header de la card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1976D2"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_building"
                        android:layout_marginEnd="12dp"
                        app:tint="@android:color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Création d'un Centre de Vote"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Contenu de la card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- ID du centre -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="#"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#1976D2"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ID du centre"
                                android:textSize="16sp"
                                android:textColor="#424242" />

                        </LinearLayout>

                        <EditText
                            android:id="@+id/etIdCentre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ex: CV001"
                            android:padding="16dp"
                            android:background="@drawable/edittext_border"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <!-- Localisation -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_location"
                                android:layout_marginEnd="8dp"
                                app:tint="#1976D2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Localisation"
                                android:textSize="16sp"
                                android:textColor="#424242" />

                        </LinearLayout>

                        <EditText
                            android:id="@+id/etLocalisation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ex: École Primaire de la Paix"
                            android:padding="16dp"
                            android:background="@drawable/edittext_border"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <!-- Bouton Ajouter bureaux (optionnel) -->
                    <Button
                        android:id="@+id/btnAjouterBureaux"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="+ Ajouter des bureaux (optionnel)"
                        android:textColor="#FFC107"
                        android:background="@drawable/btn_outline_orange"
                        android:padding="16dp"
                        android:textSize="16sp"
                        android:layout_marginBottom="20dp"
                        style="?android:attr/buttonBarButtonStyle" />

                    <!-- Bouton Créer le centre -->
                    <Button
                        android:id="@+id/btnCreerCentre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Créer le centre"
                        android:textColor="@android:color/white"
                        android:background="@drawable/btn_green"
                        android:padding="16dp"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </ScrollView>
</LinearLayout>